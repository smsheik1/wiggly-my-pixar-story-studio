{
  "name": "@wiggly/my-pixar-story-format",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "flow:login": "node runtime/flow-image.mjs login",
    "check": "node runner.mjs check",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:fast": "node --test --test-concurrency=2 $(node tests/list-tests.mjs fast)",
    "test:slow": "node --test --test-concurrency=2 $(node tests/list-tests.mjs slow)",
    "test:partition": "node tests/check-partition.mjs",
    "measure-timings": "node tests/measure-timings.mjs",
    "smoke": "node kit-smoke.mjs",
    "pack:kit": "node pack.mjs",
    "eval": "node runner.mjs eval",
    "eval:holdout": "node runner.mjs eval --split holdout",
    "dept-eval": "node runner.mjs dept-eval --all",
    "build:renderer": "node build-renderer.mjs",
    "regression": "node --test tests/supervised-regression.test.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@remotion/bundler": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "langsmith": "0.10.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.532",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "tailwindcss": "4.1.14"
  },
  "optionalDependencies": {
    "playwright-core": "1.64.0"
  }
}
