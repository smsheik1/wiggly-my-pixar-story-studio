{
  "name": "wiggly-my-pixar-story-studio",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "flow:login": "npm --prefix public/format-repositories/my-pixar-story-v1 run flow:login",
    "setup": "npm --prefix scripts/studio-spike ci && npm --prefix scripts/studio-spike run phase6:setup",
    "test": "npm run test:studio && npm run check && npm run test:kit",
    "test:studio": "npm --prefix scripts/studio-spike test",
    "check": "npm --prefix scripts/studio-spike run check",
    "test:kit": "npm --prefix public/format-repositories/my-pixar-story-v1 test",
    "test:kit:fast": "npm --prefix public/format-repositories/my-pixar-story-v1 run test:fast",
    "test:kit:slow": "npm --prefix public/format-repositories/my-pixar-story-v1 run test:slow"
  }
}
